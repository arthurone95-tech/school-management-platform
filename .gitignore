# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
/.next/
/out/

# Production build output
/build

# Testing
/coverage

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Environment files — never commit secrets.
# .env.example contains placeholders only and is intentionally tracked.
.env
.env.*
!.env.example

# Local tooling and editor state
/.vercel
/supabase/.temp
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Secrets that must never be committed
*.pem
