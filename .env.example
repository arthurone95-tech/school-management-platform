# Environment template.
#
# Copy this file to .env.local and fill in real values.
# .env.local and all other .env.* files are ignored by Git.
# Never commit real credentials.
#
# Variable names and exposure follow the current Supabase key model recorded in
# docs/PHASE0_RISK_REGISTER.md 10.1. Supabase is retiring the legacy anon and
# service_role keys in favour of publishable and secret keys.

# Public. Safe to expose to the browser. A publishable key is not a secret, but
# data access is still enforced by Row Level Security and server-side checks.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
# Never expose this value to browser code, logs, or generated output.
SUPABASE_SECRET_KEY=

# Server-only. Keys the HMAC used to hash one-time activation/reset
# credentials and shareable staff invitation tokens
# (docs/ENROLMENT_PERMISSION_MODEL.md 8.2, docs/DECISIONS.md D-025).
# Minimum 32 characters.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never commit the real value and never prefix it with NEXT_PUBLIC_.
PORTAL_CREDENTIAL_SECRET=

# Optional. Base URL of the running app used by the live verification suite
# (tests/live). Defaults to http://localhost:3100.
# LIVE_APP_URL=

# Server-only. Shared secret for /api/admin/provision-school (x-provision-secret header).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PROVISIONING_SECRET=
